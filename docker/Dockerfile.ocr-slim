# MinerU OCR Production - Optimized Slim Image
# Target: Vietnamese text + table + seal OCR without VLM
# Uses CUDA base image with minimal Python runtime

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install Python and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    libgl1 \
    libglib2.0-0 \
    fonts-noto-core \
    fonts-noto-cjk \
    fontconfig \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Create non-root user for security
RUN useradd -m -s /bin/bash mineru && \
    mkdir -p /app && chown mineru:mineru /app

WORKDIR /app

# Copy requirements first (for layer caching)
COPY --chown=mineru:mineru requirements/ocr-prod.txt .

# Install Python dependencies with CUDA-enabled torch
# torch wheel is downloaded with CUDA support from PyTorch index
RUN pip install --upgrade pip && \
    pip install -r ocr-prod.txt

# Copy project source
COPY --chown=mineru:mineru mineru ./mineru
COPY --chown=mineru:mineru pyproject.toml README.md LICENSE.md ./

# Install MinerU from source (no deps, already installed above)
RUN pip install --no-deps -e . 2>/dev/null || true

# Copy model download script
COPY --chown=mineru:mineru docker/download_prod_models.py /app/docker/download_prod_models.py

# Switch to non-root user
USER mineru

# Environment variables
ENV MINERU_MODEL_SOURCE=local
ENV MINERU_MODEL_STACK=full
ENV MINERU_FORMULA_ENABLE=false
ENV MINERU_DEVICE_MODE=cuda

# Default command
ENTRYPOINT ["mineru-kit"]
CMD [
    "api-server",
    "--host", "0.0.0.0",
    "--port", "8000",
    "--tier", "basic",
    "--language", "vi",
    "--concurrency", "1"
]
