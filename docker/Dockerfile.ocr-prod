# MinerU OCR Production - Vietnamese Edition
# Optimized for text/table/seal OCR without VLM
# Base: CUDA + cuDNN runtime (no vLLM)

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    libgl1 \
    libglib2.0-0 \
    fonts-noto-core \
    fonts-noto-cjk \
    fontconfig \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy project metadata first (for layer caching)
COPY pyproject.toml README.md LICENSE.md ./

# Copy source code
COPY mineru ./mineru

# Install MinerU from source with torch dependencies
# This installs: torch, torchvision, vietocr, transformers, etc.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install ".[torch]"

# Copy model download script
COPY docker/download_prod_models.py /app/docker/download_prod_models.py

# Download only OCR/table/seal models - NO VLM
# This will download only what's needed for Vietnamese OCR pipeline
RUN python3 /app/docker/download_prod_models.py

ENV MINERU_MODEL_SOURCE=local
ENV MINERU_MODEL_STACK=full
ENV MINERU_FORMULA_ENABLE=false
ENV MINERU_DEVICE_MODE=cuda

# Default command: start API server with production defaults
ENTRYPOINT ["mineru-kit"]
CMD [
    "api-server",
    "--host", "0.0.0.0",
    "--port", "8000",
    "--tier", "basic",
    "--language", "vi",
    "--concurrency", "1"
]
